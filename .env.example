# AgentVidBench — fill in only the rows your chosen models / framework need.

# --- GCP / Vertex AI ---
# Required for any Gemini-family run:
#   - framework=ours (the analyze_video tool is always Vertex Gemini)
#   - framework=singleturn when --model starts with "gemini"
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# GCS bucket for evaluation videos. inference.py uploads dataset/videos/*.mp4
# here on first use; later runs reuse the cached blobs.
AVB_GCS_BUCKET=
AVB_GCS_PREFIX=agentvidbench/videos

# --- OpenAI ---
# Required for `gpt-*`, `o1`, `o3`, `o4` models.
OPENAI_API_KEY=

# --- Anthropic ---
# Required for `claude-*` models.
ANTHROPIC_API_KEY=

# --- vLLM ---
# Only needed if your vLLM server isn't on the default host/port.
# Defaults: VLLM_BASE_URL=http://localhost:8000/v1, VLLM_API_KEY=EMPTY
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
